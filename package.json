{
  "name": "state-adapt",
  "license": "MIT",
  "scripts": {
    "ng": "nx",
    "prepare": "husky",
    "nx": "nx",
    "start": "npm run typedoc && nx dev docs2",
    "demo:counter": "nx serve ng-sa-counter",
    "demo:shopping": "nx serve ng-sa-shopping",
    "demo:angular": "nx serve angular-demo",
    "demo:react": "nx serve react-demo",
    "build": "npm run docs2:check",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many -t lint",
    "e2e": "nx run-many --target=e2e --all",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "scripts:check": "tsc --noEmit -p scripts/tsconfig.json",
    "update": "nx migrate latest",
    "workspace-generator": "nx workspace-generator",
    "dep-graph": "nx dep-graph",
    "help": "nx help",
    "release:version": "tsx scripts/release/version.ts",
    "release:commit": "tsx scripts/release/commit.ts",
    "release:build": "tsx scripts/release/build.ts",
    "release:pack": "tsx scripts/release/pack.ts",
    "release:registry": "npx --yes verdaccio@5.33.0 --config scripts/release/verdaccio.yaml --listen 127.0.0.1:4873",
    "release:registry:reset": "tsx scripts/release/reset-local-registry.ts",
    "release:registry:login": "tsx scripts/release/login-local-registry.ts",
    "release:publish:local": "tsx scripts/release/publish.ts --registry http://127.0.0.1:4873",
    "release:publish": "tsx scripts/release/publish.ts --registry https://registry.npmjs.org",
    "typedoc": "typedoc --options ./typedoc.json && tsx apps/docs2/pregenerate-dynamic-paths.ts && tsx scripts/docs/generate-api-packages.ts",
    "docs2:check": "nx build --project docs2",
    "docs2:publish:current": "tsx scripts/docs/publish.ts current",
    "docs2:publish:versioned": "tsx scripts/docs/publish.ts versioned"
  },
  "private": true,
