{
  "name": "docs2",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "fswatch -o ./libs | xargs -n1 npm run typedoc",
          "vitepress dev apps/docs2"
        ],
        "parallel": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/apps/docs2/.vitepress/dist"],
      "options": {
        "command": "npm run typedoc && tsx scripts/docs/build.ts"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitepress preview apps/docs2"
      }
    }
  },
  "tags": ["scope:state-adapt"]
}
