{
  "name": "@state-adapt/angular",
  "description": "Angular integration for StateAdapt state management.",
  "version": "4.0.1",
  "private": false,
  "homepage": "https://github.com/state-adapt/state-adapt",
  "author": "Mike Pearson",
  "license": "MIT",
  "keywords": [
    "angular",
    "rxjs",
    "state management",
    "state adapters"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/state-adapt/state-adapt"
  },
  "bugs": {
    "url": "https://github.com/state-adapt/state-adapt/issues"
  },
  "peerDependencies": {
    "@angular/core": ">=19.0.0",
    "@state-adapt/rxjs": "4.0.1"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "ng-update": {
    "migrations": "./schematics/migration-collection.json",
    "packageGroup": [
      "@state-adapt/core",
      "@state-adapt/rxjs",
      "@state-adapt/angular",
      "@state-adapt/angular-router",
      "@state-adapt/spaghetti-core",
      "@state-adapt/eslint-plugin-spaghetti",
      "@state-adapt/react",
      "@state-adapt/spaghetti-analyzer"
    ]
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/angular:package",
        "outputs": [
          "{workspaceRoot}/dist/libs/angular"
        ],
        "options": {
          "tsConfig": "libs/angular/tsconfig.lib.json",
          "project": "libs/angular/ng-package.json"
        },
        "configurations": {
          "production": {
            "tsConfig": "libs/angular/tsconfig.lib.prod.json"
          },
          "development": {
            "tsConfig": "libs/angular/tsconfig.lib.json"
          }
        },
        "defaultConfiguration": "production"
      },
      "test": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{workspaceRoot}/coverage/libs/angular"
        ],
        "options": {
          "jestConfig": "libs/angular/jest.config.ts",
          "passWithNoTests": true,
          "codeCoverage": true
        }
      },
      "lint": {
        "executor": "@nx/eslint:eslint",
        "options": {
          "lintFilePatterns": [
            "libs/angular/**/*.ts",
            "libs/angular/**/*.html"
          ]
        }
      }
    }
  }
}
