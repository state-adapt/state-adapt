{
  "name": "@state-adapt/angular-router",
  "description": "Angular Router integration for StateAdapt state management.",
  "version": "3.1.0",
  "private": false,
  "homepage": "https://github.com/state-adapt/state-adapt",
  "author": "Mike Pearson",
  "license": "MIT",
  "keywords": [
    "angular",
    "router",
    "rxjs",
    "state management",
    "state adapters"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/state-adapt/state-adapt"
  },
  "bugs": {
    "url": "https://github.com/state-adapt/state-adapt/issues"
  },
  "peerDependencies": {
    "@angular/core": ">=14.0.0",
    "@angular/router": ">=14.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/angular:package",
        "outputs": [
          "{workspaceRoot}/dist/libs/angular-router"
        ],
        "options": {
          "project": "libs/angular-router/ng-package.json"
        },
        "configurations": {
          "production": {
            "tsConfig": "libs/angular-router/tsconfig.lib.prod.json"
          },
          "development": {
            "tsConfig": "libs/angular-router/tsconfig.lib.json"
          }
        },
        "defaultConfiguration": "production"
      },
      "test": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{workspaceRoot}/coverage/libs/angular-router"
        ],
        "options": {
          "jestConfig": "libs/angular-router/jest.config.ts",
          "passWithNoTests": true
        }
      },
      "lint": {
        "executor": "@nx/eslint:eslint",
        "options": {
          "lintFilePatterns": [
            "libs/angular-router/**/*.ts",
            "libs/angular-router/**/*.html"
          ]
        }
      }
    }
  }
}
